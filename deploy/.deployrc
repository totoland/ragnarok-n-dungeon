# Deploy config for ragnarok-n-dungeon — committed to git.
# Override per-machine in .deployrc.local (gitignored).

PI=pi@192.168.0.125                                 # SSH target running k3s
IMAGE_REPO=ghcr.io/totoland/ragnarok-n-dungeon      # repo WITHOUT tag — deploy.sh appends :sha-<gitsha>
DEPLOYMENT=ragnarok-n-dungeon                       # same Deployment name in both namespaces
PLATFORM=linux/arm64                                # Pi 5 is arm64
GIT_BRANCH=main                                     # branch Argo CD tracks
REMOTE_CTX=/home/pi/build/ragnarok-n-dungeon         # build context on the Pi (no ~: it would expand locally)

# Two environments, one image. `deploy.sh` builds into lab; `deploy.sh prod` promotes.
LAB_NAMESPACE=ragnarok-n-dungeon-lab
LAB_ARGOCD_APP=ragnarok-n-dungeon-lab
LAB_HOST=ragnarok-lab.192-168-0-125.nip.io
LAB_PUBLIC=https://ragnarok-lab.totoland.cloud
PROD_NAMESPACE=ragnarok-n-dungeon
PROD_ARGOCD_APP=ragnarok-n-dungeon
PROD_HOST=ragnarok-n-dungeon.192-168-0-125.nip.io
PROD_PUBLIC=https://ragnarok.totoland.cloud
