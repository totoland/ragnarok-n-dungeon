.DS_Store
node_modules/
__pycache__/
*.blend1
docs/screenshots/*.png
# Blender portrait renders: large, and not needed to rebuild anything.
assets/blender/**/*_preview.png
assets/blender/**/*_detail.png
assets/blender/**/preview*.png
.playwright-mcp/
# Deploy targets: the Pi's address and the real hostnames stay out of a public repo.
deploy/.deployrc
deploy/.deployrc.local
docs/telemetry.ndjson

# Native build: www/ is assembled by tools/build-web.mjs (and may carry the lab hostname),
# Pods and the copied web folder are products of `cap sync`.
www/
ios/App/Pods/
ios/App/App/public/
# Who signs the build: personal, and specific to one machine.
ios/local.xcconfig

# King Orc's source sculpt: 42 MB, three times the next-largest .blend, and it does not
# compress. Kept on the machine it was made on rather than in the public history, where it
# would stay for good. The GLB it exports IS committed, so the game never needs it; only a
# re-export does. (Toto's call, option B.)
assets/blender/dwarf_warrior_game_source.blend
